---
/**
 * ExtractDecideDemo — live dashboard for Extract + Decide recipes
 * (`/extract-decide`), combining `@cf/cloudflare/clef-flash` and
 * `@cf/cloudflare/clairic` on each sampled frame.
 *
 * Shows one large result card (readable from a few feet away),
 * then the two pipeline stages underneath: what Clef Flash decided, whether
 * it gated or routed the frame, and what Clairic extracted. Recipes, gating,
 * routing, and maths run server-side in `src/lib/extract-decide.ts`.
 */
import { RECIPE_MENU } from '../lib/extract-decide.ts';

const defaultRecipe = RECIPE_MENU[0];
---

<section id="demo" class="demo-section container scroll-reveal" aria-labelledby="xd-title">
	<div class="demo-card corner-card" data-xd-demo>
		<span class="corner-top-right"></span>
		<span class="corner-bottom-left"></span>

		<div class="demo-header">
			<div>
				<p class="eyebrow">Extract + Decide</p>
				<h2 id="xd-title">Two models, one answer</h2>
			</div>
			<div class="status-badge" aria-live="polite">
				<span class="status-dot" aria-hidden="true"></span>
				<span data-status-text>Idle</span>
			</div>
		</div>

		<div class="preset-bar">
			<div class="preset-selector" role="group" aria-label="Recipe selector">
				<span class="selector-label">Recipe</span>
				{RECIPE_MENU.map(({ key, label }) => (
					<button
						class:list={['preset-button', { active: key === defaultRecipe.key }]}
						type="button"
						data-recipe-button
						data-recipe={key}
					>
						{label}
					</button>
				))}
			</div>

			<div class="xd-settings">
				<label class="setting" data-setting="hydrationGoalMl" hidden={!defaultRecipe.settings.includes('hydrationGoalMl')}>
					<span>Water goal</span>
					<select data-goal>
						<option value="2000">2.0 L</option>
						<option value="2500" selected>2.5 L</option>
						<option value="3000">3.0 L</option>
						<option value="3700">3.7 L</option>
					</select>
				</label>
			</div>
		</div>

		<p class="recipe-blurb" data-recipe-blurb>{defaultRecipe.blurb}</p>

		<div class="demo-grid">
			<div class="video-panel">
				<div class="video-stage">
					<video id="xd-camera-video" muted playsinline></video>
					<div class="frame-pulse" data-frame-pulse aria-hidden="true"></div>
					<div class="stage-tag" data-stage-tag>Clef Flash decides · Clairic measures</div>
					<div class="empty-state" data-empty-state>
						<div class="camera-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h7A2.5 2.5 0 0 1 16 6.5V8l3.72-2.13A1.5 1.5 0 0 1 22 7.17v9.66a1.5 1.5 0 0 1-2.28 1.3L16 16v1.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 4 17.5v-11Zm2.5-.5A.5.5 0 0 0 6 6.5v11a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-7Zm9.5 4.3v3.4l4 2.29V8.01l-4 2.29Z"></path>
							</svg>
						</div>
						<p>Pick a recipe, start the camera, and show it what the recipe asks for.</p>
						<span>Clef Flash decides what it is looking at; Clairic measures it. Nothing is stored.</span>
					</div>
				</div>

				<canvas id="xd-capture-buffer" width="640" height="360" hidden></canvas>

				<div class="controls" aria-label="Extract + Decide controls">
					<button class="control-button primary" type="button" data-start-button>Start camera</button>
					<button class="control-button ghost" type="button" data-pause-button disabled>Pause stream</button>
					<button class="control-button outline" type="button" data-switch-button disabled>Switch camera</button>
				</div>

				<div class="error-panel" data-error-panel hidden role="alert"></div>
			</div>

			<aside class="decisions-panel" aria-labelledby="xd-result-title">
				<div class="panel-heading">
					<div>
						<p class="eyebrow" data-route-label>Result</p>
						<h3 id="xd-result-title" data-recipe-title>{defaultRecipe.label}</h3>
					</div>
					<span class="threshold" data-mode-badge>-</span>
				</div>

				<div class="result-card" data-result-card data-state="waiting">
					<p class="result-hero" data-result-hero hidden aria-hidden="true"></p>
					<svg class="result-dial" data-result-dial viewBox="-110 -110 220 220" hidden aria-label="Measured hand angles"></svg>
					<p class="result-headline" data-result-headline>Waiting for a frame</p>
					<p class="result-compare" data-result-compare hidden></p>
					<p class="result-subline" data-result-subline></p>
					<dl class="result-facts" data-result-facts></dl>
					<p class="result-note" data-result-note hidden></p>
				</div>
			</aside>
		</div>

		<div class="pipeline" aria-label="Pipeline stages">
			<article class="stage-card" data-stage="decide">
				<header>
					<span class="stage-num">1</span>
					<div>
						<p class="eyebrow">Decide</p>
						<h4>@cf/cloudflare/clef-flash</h4>
					</div>
					<span class="stage-time" data-stage-time>-</span>
				</header>
				<div class="stage-rows" data-stage-rows><p class="stage-empty">Not run yet</p></div>
			</article>
			<div class="stage-arrow" aria-hidden="true" data-stage-arrow>→</div>
			<article class="stage-card" data-stage="extract">
				<header>
					<span class="stage-num">2</span>
					<div>
						<p class="eyebrow">Extract</p>
						<h4>@cf/cloudflare/clairic</h4>
					</div>
					<span class="stage-time" data-stage-time>-</span>
				</header>
				<div class="stage-rows" data-stage-rows><p class="stage-empty">Not run yet</p></div>
			</article>
		</div>

		<div class="stats-grid" aria-label="Extract + Decide telemetry">
			<div class="stat-card"><span>Round trip</span><strong data-stat-latency>-</strong></div>
			<div class="stat-card"><span>Server</span><strong data-stat-inference>-</strong></div>
			<div class="stat-card"><span>Model calls</span><strong data-stat-calls>-</strong></div>
			<div class="stat-card"><span>Clairic</span><strong data-stat-mode>-</strong></div>
			<div class="stat-card"><span>Input tokens</span><strong data-stat-tokens>-</strong></div>
			<div class="stat-card"><span>Payload</span><strong data-stat-bytes>-</strong></div>
		</div>
	</div>
</section>

<script>
	import { compareToClock, describeComparison, formatReading } from '../lib/clock.ts';
	import { RECIPE_MENU } from '../lib/extract-decide.ts';

	const root = document.querySelector<HTMLElement>('[data-xd-demo]');
	if (root) initExtractDecide(root);

	function initExtractDecide(root: HTMLElement) {
		const sampleMs = 1500;

		const q = <T extends Element = HTMLElement>(sel: string, scope: ParentNode = root) => scope.querySelector(sel) as T;
		const decideCard = q('[data-stage="decide"]');
		const extractCard = q('[data-stage="extract"]');
		const refs = {
			video: q<HTMLVideoElement>('#xd-camera-video'),
			buffer: q<HTMLCanvasElement>('#xd-capture-buffer'),
			empty: q('[data-empty-state]'),
			pulse: q('[data-frame-pulse]'),
			statusText: q('[data-status-text]'),
			startButton: q<HTMLButtonElement>('[data-start-button]'),
			pauseButton: q<HTMLButtonElement>('[data-pause-button]'),
			switchButton: q<HTMLButtonElement>('[data-switch-button]'),
			errorPanel: q('[data-error-panel]'),
			recipeButtons: root.querySelectorAll<HTMLButtonElement>('[data-recipe-button]'),
			goal: q<HTMLSelectElement>('[data-goal]'),
			settingControls: root.querySelectorAll<HTMLElement>('[data-setting]'),
			blurb: q('[data-recipe-blurb]'),
			title: q('[data-recipe-title]'),
			routeLabel: q('[data-route-label]'),
			modeBadge: q('[data-mode-badge]'),
			resultCard: q('[data-result-card]'),
			hero: q('[data-result-hero]'),
			dial: q<SVGSVGElement>('[data-result-dial]'),
			compare: q('[data-result-compare]'),
			headline: q('[data-result-headline]'),
			subline: q('[data-result-subline]'),
			facts: q('[data-result-facts]'),
			note: q('[data-result-note]'),
			decideRows: q('[data-stage-rows]', decideCard),
			decideTime: q('[data-stage-time]', decideCard),
			extractRows: q('[data-stage-rows]', extractCard),
			extractTime: q('[data-stage-time]', extractCard),
			arrow: q('[data-stage-arrow]'),
			latency: q('[data-stat-latency]'),
			inference: q('[data-stat-inference]'),
			calls: q('[data-stat-calls]'),
			mode: q('[data-stat-mode]'),
			tokens: q('[data-stat-tokens]'),
			bytes: q('[data-stat-bytes]'),
		};

		let stream: MediaStream | null = null;
		let intervalId: number | null = null;
		let inFlight: AbortController | null = null;
		let facingMode = 'user';
		let preferredDeviceId: string | null = null;
		let selectedRecipe = RECIPE_MENU[0].key as string;
		const captureFor = () => (RECIPE_MENU.find((r) => r.key === selectedRecipe) ?? RECIPE_MENU[0]).capture;
		const bufferContext = refs.buffer.getContext('2d')!;

		// ---------- rendering ----------

		function resetView() {
			refs.resultCard.dataset.state = 'waiting';
			refs.hero.hidden = true;
			refs.dial.setAttribute('hidden', '');
			refs.compare.hidden = true;
			refs.headline.textContent = 'Waiting for a frame';
			refs.subline.textContent = '';
			refs.facts.innerHTML = '';
			refs.note.hidden = true;
			refs.routeLabel.textContent = 'Result';
			refs.modeBadge.textContent = '-';
			for (const [rows, time] of [
				[refs.decideRows, refs.decideTime],
				[refs.extractRows, refs.extractTime],
			]) {
				rows.innerHTML = '<p class="stage-empty">Not run yet</p>';
				time.textContent = '-';
			}
		}

		function renderPayload(p: any) {
			refs.modeBadge.textContent = p.skipped ? 'gated' : 'gate → measure';
			refs.routeLabel.textContent = p.route?.label ?? 'Result';

			if (p.result) {
				refs.resultCard.dataset.state = 'result';
				refs.hero.hidden = !p.result.hero || Boolean(p.result.dial);
				refs.hero.textContent = p.result.hero || '';
				renderDial(p.result.dial);
				renderComparison(p.result.clock);
				refs.headline.textContent = p.result.headline;
				refs.subline.textContent = p.result.subline || '';
				refs.facts.innerHTML = (p.result.facts || [])
					.map((f: any) => `<div><dt>${esc(f.label)}</dt><dd>${esc(f.value)}</dd></div>`)
					.join('');
				refs.note.hidden = !p.result.note;
				refs.note.textContent = p.result.note || '';
			} else {
				refs.resultCard.dataset.state = 'skipped';
				refs.hero.hidden = true;
				refs.dial.setAttribute('hidden', '');
				refs.compare.hidden = true;
				refs.headline.textContent = p.skipped || 'Nothing to show';
				refs.subline.textContent = '';
				refs.facts.innerHTML = '';
				refs.note.hidden = true;
			}

			renderDecide(p.decide);
			renderExtract(p.extract, p.skipped);
		}

		/** Draw the dial: tick marks, a shaded p10–p90 wedge per hand, and the resolved hands. */
		function renderDial(dial: any) {
			if (!dial) {
				refs.dial.setAttribute('hidden', '');
				return;
			}
			refs.dial.removeAttribute('hidden');
			const polar = (deg: number, r: number) => {
				const rad = ((deg - 90) * Math.PI) / 180;
				return `${(Math.cos(rad) * r).toFixed(1)} ${(Math.sin(rad) * r).toFixed(1)}`;
			};
			const wedge = (s: any, r: number, cls: string) => {
				let span = (((s.high - s.low) % 360) + 360) % 360;
				if (span < 2) span = 2;
				const large = span > 180 ? 1 : 0;
				return `<path class="${cls}" d="M 0 0 L ${polar(s.low, r)} A ${r} ${r} 0 ${large} 1 ${polar(s.low + span, r)} Z" />`;
			};
			const ticks = Array.from({ length: 12 }, (_, i) => {
				const deg = i * 30;
				return `<line class="dial-tick" x1="${polar(deg, 88).split(' ')[0]}" y1="${polar(deg, 88).split(' ')[1]}" x2="${polar(deg, 100).split(' ')[0]}" y2="${polar(deg, 100).split(' ')[1]}" />`;
			}).join('');
			const hand = (deg: number, r: number, cls: string) => {
				const [x, y] = polar(deg, r).split(' ');
				return `<line class="${cls}" x1="0" y1="0" x2="${x}" y2="${y}" />`;
			};
			refs.dial.innerHTML = `
				<circle class="dial-face" r="104" />
				${ticks}
				<text class="dial-twelve" x="0" y="-70">12</text>
				${wedge(dial.minute, 86, 'dial-wedge minute')}
				${wedge(dial.hour, 56, 'dial-wedge hour')}
				${hand(dial.minute.mid, 86, 'dial-hand minute')}
				${hand(dial.hour.mid, 56, 'dial-hand hour')}
				<circle class="dial-pin" r="5" />`;
		}

		/** Compare a reading with this browser's clock (never sent to the models). */
		function renderComparison(clock: any) {
			if (!clock) {
				refs.compare.hidden = true;
				return;
			}
			const now = new Date();
			const actual = { hours: now.getHours() % 12 || 12, minutes: now.getMinutes() };
			refs.compare.hidden = false;
			refs.compare.textContent = `Actual ${formatReading(actual)} → ${describeComparison(compareToClock(clock, actual))}`;
		}

		function renderDecide(stage: any) {
			refs.decideTime.textContent = stage ? `${stage.ms} ms` : '-';
			if (!stage) return;
			const questions = stage.questions || {};
			refs.decideRows.innerHTML = Object.entries(questions)
				.map(([id, question]: [string, any]) => {
					const a = stage.answers?.[id];
					let text = '—';
					let p = 0;
					if (a && typeof a.noul === 'number') {
						p = a.noul;
						text = `${p >= 0.5 ? 'yes' : 'no'} · ${pct(p)}`;
					} else if (a && a.probabilities) {
						const entries = Object.entries(a.probabilities as Record<string, number>).sort((x, y) => y[1] - x[1]);
						const [top, topP] = entries[0] || ['—', 0];
						p = topP;
						const label = question.type === 'score' ? question.criteria?.[Number(top)]?.replace(/\s*\(.*\)$/, '') : top;
						text = `${String(label ?? top).replace(/_/g, ' ')} · ${pct(topP)}`;
					}
					return row(id, text, p);
				})
				.join('');
		}

		function renderExtract(stage: any, skipped: string | null) {
			refs.extractTime.textContent = stage ? `${stage.ms} ms` : skipped ? 'skipped' : '-';
			if (!stage) {
				refs.extractRows.innerHTML = `<p class="stage-empty">${esc(skipped ? `Gated: ${skipped}` : 'Not run')}</p>`;
				return;
			}
			const fields = stage.fields || {};
			refs.extractRows.innerHTML = Object.entries(fields)
				.map(([name, field]: [string, any]) => {
					const a = stage.answers?.[name];
					let text = '—';
					let p = 0;
					if (a) {
						const unit = field.unit ? ` ${field.unit}` : '';
						if (typeof a.median === 'number') {
							text = `${fmt(a.median)}${unit} (${fmt(a.p10)}–${fmt(a.p90)})`;
							p = 1;
						} else if (Array.isArray(a.value)) {
							text = a.value.join(', ') || 'none';
							p = typeof a.confidence === 'number' ? a.confidence : 0;
						} else if (a.value !== null && a.value !== undefined) {
							text = `${typeof a.value === 'number' ? fmt(a.value) : a.value}${unit}`;
							p = typeof a.confidence === 'number' ? a.confidence : 0;
						} else {
							text = 'not found';
						}
					}
					return row(name, text, p);
				})
				.join('');
		}

		function row(id: string, text: string, p: number) {
			return `
				<div class="stage-row">
					<span class="stage-id">${esc(id)}</span>
					<span class="stage-val" title="${esc(text)}">${esc(text)}</span>
					<span class="prob-track"><span class="prob-fill" style="width:${(clamp(p, 0, 1) * 100).toFixed(0)}%"></span></span>
				</div>`;
		}

		function updateStats(roundTripMs: number, p: any) {
			refs.latency.textContent = `${Math.round(roundTripMs)} ms`;
			refs.inference.textContent = Number.isFinite(p.inferenceMs) ? `${Math.round(p.inferenceMs)} ms` : '-';
			refs.calls.textContent = String(p.calls ?? (p.extract ? 2 : 1));
			refs.mode.textContent = p.skipped ? 'skipped' : 'called';
			const tokens = (p.decide?.usage?.input_tokens || 0) + (p.extract?.usage?.input_tokens || 0);
			refs.tokens.textContent = tokens ? String(tokens) : '-';
			refs.bytes.textContent = Number.isFinite(p.bytes) ? `${Math.round(p.bytes / 1024)} KB` : '-';
		}

		const pct = (p: number) => `${Math.round(clamp(p, 0, 1) * 100)}%`;
		const fmt = (n: unknown) =>
			typeof n === 'number' ? n.toLocaleString(undefined, { maximumFractionDigits: 1 }) : String(n ?? '—');
		const clamp = (v: number, min: number, max: number) => Math.min(Math.max(v, min), max);
		const esc = (v: unknown) =>
			String(v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

		// ---------- status ----------

		function setStatus(text: string, state: string) {
			refs.statusText.textContent = text;
			root.dataset.status = state;
		}

		function setError(message: string) {
			refs.errorPanel.hidden = false;
			refs.errorPanel.textContent = message;
			setStatus('Error', 'error');
		}

		function clearError() {
			refs.errorPanel.hidden = true;
			refs.errorPanel.textContent = '';
		}

		// ---------- camera + capture ----------

		function startPolling() {
			if (intervalId) return;
			captureAndRun();
			intervalId = window.setInterval(captureAndRun, sampleMs);
		}

		function stopPolling() {
			if (intervalId) {
				window.clearInterval(intervalId);
				intervalId = null;
			}
			inFlight?.abort();
			inFlight = null;
		}

		async function listVideoInputs() {
			if (!navigator.mediaDevices?.enumerateDevices) return [];
			const devices = await navigator.mediaDevices.enumerateDevices();
			const inputs: MediaDeviceInfo[] = [];
			for (const d of devices) {
				if (d.kind !== 'videoinput' || !d.deviceId) continue;
				if (inputs.some((i) => i.deviceId === d.deviceId)) continue;
				inputs.push(d);
			}
			return inputs;
		}

		function activeVideoDeviceId() {
			return stream?.getVideoTracks?.()[0]?.getSettings?.().deviceId || preferredDeviceId;
		}

		async function openCameraStream() {
			const size = { width: { ideal: 1280 }, height: { ideal: 720 } };
			const attempts: MediaTrackConstraints[] = [];
			if (preferredDeviceId) {
				attempts.push({ ...size, deviceId: { exact: preferredDeviceId } });
				attempts.push({ deviceId: { exact: preferredDeviceId } });
			}
			attempts.push({ ...size, facingMode });
			let lastError: unknown = null;
			for (const video of attempts) {
				try {
					return await navigator.mediaDevices.getUserMedia({ audio: false, video });
				} catch (error) {
					lastError = error;
					if ((error as DOMException)?.name === 'NotAllowedError') throw error;
				}
			}
			throw lastError;
		}

		async function startCamera() {
			clearError();
			if (!navigator.mediaDevices?.getUserMedia) {
				setError('This browser does not expose getUserMedia. Try a current desktop or mobile browser.');
				return;
			}
			if (!window.isSecureContext && location.hostname !== 'localhost') {
				setError('Camera capture requires HTTPS. Deploy to workers.dev or run on localhost.');
				return;
			}
			setStatus('Requesting camera', 'pending');
			refs.startButton.disabled = true;
			try {
				stream = await openCameraStream();
				preferredDeviceId = activeVideoDeviceId() || preferredDeviceId;
				refs.video.srcObject = stream;
				await refs.video.play();
				refs.empty.hidden = true;
				refs.pauseButton.disabled = false;
				refs.switchButton.disabled = false;
				const label = (await listVideoInputs()).find((d) => d.deviceId === activeVideoDeviceId())?.label?.trim();
				refs.switchButton.title = label ? `Switch camera (current: ${label})` : 'Switch camera';
				setStatus('Streaming', 'streaming');
				startPolling();
			} catch (error) {
				refs.startButton.disabled = false;
				setError(
					(error as DOMException)?.name === 'NotAllowedError'
						? 'Camera permission was denied. Allow camera access and try again.'
						: 'Could not start the camera on this device.'
				);
			}
		}

		function stopCamera() {
			stopPolling();
			if (stream) {
				for (const t of stream.getTracks()) t.stop();
				stream = null;
			}
			refs.video.srcObject = null;
			refs.empty.hidden = false;
			refs.startButton.disabled = false;
			refs.pauseButton.disabled = true;
			refs.switchButton.disabled = true;
			setStatus('Paused', 'idle');
		}

		async function switchCamera() {
			let inputs: MediaDeviceInfo[] = [];
			try {
				inputs = await listVideoInputs();
			} catch {
				inputs = [];
			}
			if (inputs.length > 1) {
				const current = inputs.findIndex((d) => d.deviceId === activeVideoDeviceId());
				preferredDeviceId = inputs[current >= 0 ? (current + 1) % inputs.length : 1].deviceId;
			} else {
				facingMode = facingMode === 'user' ? 'environment' : 'user';
				preferredDeviceId = null;
			}
			stopCamera();
			await startCamera();
		}

		function settings() {
			return {
				hydrationGoalMl: Number(refs.goal.value),
			};
		}

		async function captureAndRun() {
			if (!stream || inFlight || refs.video.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) return;
			const { width, height } = captureFor();
			refs.buffer.width = width;
			refs.buffer.height = height;
			bufferContext.drawImage(refs.video, 0, 0, width, height);
			const image = refs.buffer.toDataURL('image/jpeg', width > 640 ? 0.85 : 0.7);
			if (!image || image === 'data:,') return;

			const controller = new AbortController();
			inFlight = controller;
			setStatus('Deciding + extracting', 'detecting');
			const started = performance.now();
			try {
				const response = await fetch('/api/extract-decide', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ image, recipe: selectedRecipe, settings: settings() }),
					signal: controller.signal,
				});
				const payload = await response.json().catch(() => ({}));
				if (!response.ok) {
					const where = payload.stage ? ` (${payload.stage} stage, ${payload.model})` : '';
					throw new Error(`${payload.error || `Request failed with ${response.status}`}${where}`);
				}
				renderPayload(payload);
				updateStats(performance.now() - started, payload);
				refs.pulse.classList.add('active');
				window.setTimeout(() => refs.pulse.classList.remove('active'), 140);
				setStatus('Streaming', 'streaming');
			} catch (error) {
				if ((error as Error)?.name === 'AbortError') return;
				setError((error as Error)?.message || 'Extract + Decide request failed.');
				stopPolling();
			} finally {
				if (inFlight === controller) inFlight = null;
			}
		}

		function restart() {
			clearError();
			resetView();
			if (stream) {
				inFlight?.abort();
				inFlight = null;
				captureAndRun();
			}
		}

		function setRecipe(key: string | undefined) {
			const entry = RECIPE_MENU.find((r) => r.key === key);
			if (!entry) return;
			selectedRecipe = entry.key;
			refs.recipeButtons.forEach((b) => b.classList.toggle('active', b.dataset.recipe === entry.key));
			refs.title.textContent = entry.label;
			refs.blurb.textContent = entry.blurb;
			refs.settingControls.forEach((el) => {
				el.hidden = !entry.settings.includes(el.dataset.setting as any);
			});
			restart();
		}

		refs.startButton.addEventListener('click', startCamera);
		refs.pauseButton.addEventListener('click', stopCamera);
		refs.switchButton.addEventListener('click', switchCamera);
		refs.recipeButtons.forEach((b) => b.addEventListener('click', () => setRecipe(b.dataset.recipe)));
		refs.goal.addEventListener('change', restart);

		document.addEventListener('visibilitychange', () => {
			if (document.hidden) stopPolling();
			else if (stream) startPolling();
		});
		window.addEventListener('beforeunload', stopCamera);
	}
</script>

