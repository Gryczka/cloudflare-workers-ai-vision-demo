---
/** `/architecture` — Static reference-architecture page (diagram + per-route flow breakdown). */
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import FlowBreakdown from '../components/FlowBreakdown.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Layout from '../layouts/Layout.astro';

const steps = [
	{
		accent: 'compute',
		title: 'Push expensive work to Workers AI',
		body: 'DETR, generative vision models, and @cf/cloudflare/clef-flash run behind an AI binding while the browser keeps capture, overlays, and probability meters lightweight.',
	},
	{
		accent: 'ai',
		title: 'Keep state in the browser',
		body: 'Zones, event logs, model choices, PPE assessments, and custom Clef question schemas are tab-local, so the demo avoids extra persistence services.',
	},
	{
		accent: 'media',
		title: 'Optionally gate with Access',
		body: 'The Worker deploys open to the internet by default. You can optionally put Cloudflare Access in front of it to restrict the deployment to specific users or email domains.',
	},
] as const;
---

<Layout>
	<Header />
	<main>
		<Hero
			kicker="Reference architecture"
			title="From camera to Workers AI and back"
			subtitle="A static map of how this demo pushes frames to Cloudflare, runs DETR, vision LLMs, and Clef Flash on Workers AI, and renders detections and calibrated probabilities back in the browser."
			model="Astro · Workers · Workers AI · optional Access"
			meta="static SVG · zero JavaScript"
			cta={{ label: 'See the architecture', href: '#architecture' }}
		/>
		<ArchitectureDiagram />
		<FlowBreakdown />
		<HowItWorks title="Why this shape?" subtitle="The same platform primitives support live detection, virtual perimeter monitoring, PPE compliance, and structured multimodal decisions with only route-level behavior changes." steps={steps} />
	</main>
	<Footer />
</Layout>
